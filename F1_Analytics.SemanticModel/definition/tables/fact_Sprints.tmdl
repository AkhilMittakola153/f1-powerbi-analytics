	column StatusText
		dataType: string
		lineageTag: 34c50413-6997-4b6c-98fa-866fbf2f0be0
		summarizeBy: none
		sourceColumn: StatusText

		annotation SummarizationSetBy = Automatic

	partition fact_Sprints = m
		mode: import
		queryGroup: Staging
		source =
				let
				    Combined = Table.Combine({hist_Sprints, api_Sprints}),
				    AddStatus = Table.AddColumn(Combined, "StatusText",
				        each if [detail] <> null then [detail] else [status], type text),
				    Keep = Table.SelectColumns(AddStatus,
				        {"RaceKey", "driverId", "constructorId", "grid", "position",
				         "points", "StatusText"})
				in
				    Keep

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

