	partition dim_Race = m
		mode: import
		queryGroup: Staging
		source =
				let
				    Sea = Table.RenameColumns(
				        Table.SelectColumns(HistCsv("formula_one_season"), {"id","year"}),
				        {{"id","sea_id"}}),
				    Cir = Table.RenameColumns(
				        Table.SelectColumns(HistCsv("formula_one_circuit"),
				            {"id","reference","name","locality","country","latitude","longitude"}),
				        {{"id","cir_id"},{"reference","circuitId"},{"name","circuitName"},
				         {"latitude","lat"},{"longitude","long"}}),
				    Rnd = Table.SelectColumns(HistCsv("formula_one_round"),
				            {"season_id","circuit_id","number","name","date","is_cancelled"}),
				    J1 = Table.Join(Rnd, "season_id", Sea, "sea_id"),
				    J2 = Table.Join(J1, "circuit_id", Cir, "cir_id"),
				    Hist0 = Table.SelectRows(J2, each Number.From([year]) < CurrentSeason),
				    Hist = Table.RenameColumns(
				        Table.SelectColumns(Hist0, {"year","number","name","date","circuitId",
				            "circuitName","locality","country","lat","long","is_cancelled"}),
				        {{"year","season"},{"number","round"},{"name","raceName"}}),
				    HistTyped = Table.TransformColumnTypes(Hist, {{"season", Int64.Type},
				        {"round", Int64.Type}, {"date", type date},
				        {"lat", type number}, {"long", type number}}, "en-US"),
				    HistKey = Table.AddColumn(HistTyped, "RaceKey",
				        each [season] * 100 + [round], Int64.Type),
				    Api = Table.SelectColumns(api_Races, {"RaceKey","season","round","raceName",
				        "date","circuitId","circuitName","locality","country","lat","long"}),
				    Combined = Table.Combine({HistKey, Api}),
				    AddLabel = Table.AddColumn(Combined, "RaceLabel",
				        each Text.From([season]) & " R" & Text.PadStart(Text.From([round]), 2, "0")
				             & " " & [raceName], type text)
				in
				    AddLabel

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

