	partition dim_Driver = m
		mode: import
		queryGroup: Staging
		source =
				let
				    Hist = Table.RenameColumns(
				        Table.SelectColumns(HistCsv("formula_one_driver"),
				            {"reference","abbreviation","forename","surname","nationality","date_of_birth"}),
				        {{"reference","driverId"},{"abbreviation","code"},
				         {"forename","givenName"},{"surname","familyName"}}),
				    Api = Table.Distinct(Table.SelectColumns(api_Results,
				            {"driverId","code","givenName","familyName","nationality"})),
				    Unique = Table.Distinct(Table.Buffer(Table.Combine({Hist, Api})), {"driverId"}),
				    Typed = Table.TransformColumnTypes(Unique, {{"date_of_birth", type date}}, "en-US"),
				    AddName = Table.AddColumn(Typed, "DriverName",
				            each [givenName] & " " & [familyName], type text)
				in
				    AddName

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

