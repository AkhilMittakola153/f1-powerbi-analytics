	column StatusGroup
		dataType: string
		lineageTag: d4b8dea2-978c-43dc-9187-8f6909136808
		summarizeBy: none
		sourceColumn: StatusGroup

		annotation SummarizationSetBy = Automatic

	partition fact_Results = m
		mode: import
		queryGroup: Staging
		source =
				let
				    Combined = Table.Combine({hist_Results, api_Results}),
				    AddStatus = Table.AddColumn(Combined, "StatusText",
				        each if [detail] <> null then [detail] else [status], type text),
				    AddGroup = Table.AddColumn(AddStatus, "StatusGroup", each
				        if [StatusText] = "Finished" then "Finished"
				        else if [StatusText] = "Lapped"
				             or ([StatusText] <> null and Text.StartsWith([StatusText], "+")) then "Lapped"
				        else "DNF/Other", type text),
				    Keep = Table.SelectColumns(AddGroup,
				        {"RaceKey", "driverId", "constructorId", "number", "grid", "position",
				         "points", "laps", "fastestLapRank", "StatusText", "StatusGroup"})
				in
				    Keep

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

