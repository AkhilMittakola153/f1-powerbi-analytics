	partition api_Results = m
		mode: import
		queryGroup: Staging
		source =
				let
				    PageSize = 100,
				    GetPage = (offset as number) =>
				        Json.Document(
				            Web.Contents(
				                BaseUrl,
				                [
				                    RelativePath = Number.ToText(CurrentSeason) & "/results/",
				                    Query = [
				                        limit  = Number.ToText(PageSize),
				                        offset = Number.ToText(offset)
				                    ]
				                ]
				            )
				        )[MRData],
				    First   = GetPage(0),
				    Total   = Number.From(First[total]),
				    Offsets = List.Numbers(0, Number.RoundUp(Total / PageSize), PageSize),
				    Pages   = List.Transform(Offsets, each if _ = 0 then First else GetPage(_)),
				    Races   = List.Combine(List.Transform(Pages, each [RaceTable][Races])),
				    ToTable = Table.FromList(Races, Splitter.SplitByNothing(), {"Race"}),
				    ExpRace = Table.ExpandRecordColumn(ToTable, "Race",
				        {"season", "round", "Results"}),
				    ExpList = Table.ExpandListColumn(ExpRace, "Results"),
				    ExpRes  = Table.ExpandRecordColumn(ExpList, "Results",
				        {"number", "position", "positionText", "points", "grid", "laps",
				         "status", "Driver", "Constructor", "Time", "FastestLap"}),
				    ExpDrv  = Table.ExpandRecordColumn(ExpRes, "Driver",
				        {"driverId", "code", "givenName", "familyName", "nationality"}),
				    ExpCon  = Table.ExpandRecordColumn(ExpDrv, "Constructor",
				        {"constructorId", "name"}, {"constructorId", "constructorName"}),
				    ExpTime = Table.ExpandRecordColumn(ExpCon, "Time",
				        {"millis"}, {"raceMillis"}),
				    ExpFL   = Table.ExpandRecordColumn(ExpTime, "FastestLap",
				        {"rank"}, {"fastestLapRank"}),
				    Typed = Table.TransformColumnTypes(ExpFL, {
				        {"season", Int64.Type}, {"round", Int64.Type},
				        {"number", Int64.Type}, {"position", Int64.Type},
				        {"points", type number}, {"grid", Int64.Type},
				        {"laps", Int64.Type}, {"raceMillis", Int64.Type},
				        {"fastestLapRank", Int64.Type}
				    }, "en-US"),
				    AddRaceKey = Table.AddColumn(Typed, "RaceKey",
				        each [season] * 100 + [round], Int64.Type)
				in
				    AddRaceKey

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

