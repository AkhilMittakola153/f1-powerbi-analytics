expression BaseUrl = "https://api.jolpi.ca/ergast/f1/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 622ff64a-4eb1-4ef7-a97d-369aeba544f2
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression CurrentSeason = 2026 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: 0620b8d7-e71f-41fa-908c-f008f0078716
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Number

expression HistoryUrl = "https://raw.githubusercontent.com/AkhilMittakola153/f1-powerbi-analytics/main/data/history/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 97c45fa1-7c3b-4442-8d25-92ce68cf48f6
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression HistCsv =
		(tableName as text) as table =>
		let
		    Src = Csv.Document(
		        Web.Contents(HistoryUrl, [RelativePath = tableName & ".csv"]),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Src, [PromoteAllScalars = true]),
		    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _)
		in
		    Blanks
	lineageTag: 5c238643-b571-43d9-b266-e07bb1a4847e
	queryGroup: Parameters

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression api_Results =
		let
		    PageSize = 100,
		    GetPage = (offset as number) =>
		        Json.Document(
		            Web.Contents(
		                BaseUrl,
		                [
		                    RelativePath = Number.ToText(CurrentSeason) & "/results/",
		                    Query = [
		                        limit  = Number.ToText(PageSize),
		                        offset = Number.ToText(offset)
		                    ]
		                ]
		            )
		        )[MRData],
		    First   = GetPage(0),
		    Total   = Number.From(First[total]),
		    Offsets = List.Numbers(0, Number.RoundUp(Total / PageSize), PageSize),
		    Pages   = List.Transform(Offsets, each if _ = 0 then First else GetPage(_)),
		    Races   = List.Combine(List.Transform(Pages, each [RaceTable][Races])),
		    ToTable = Table.FromList(Races, Splitter.SplitByNothing(), {"Race"}),
		    ExpRace = Table.ExpandRecordColumn(ToTable, "Race",
		        {"season", "round", "Results"}),
		    ExpList = Table.ExpandListColumn(ExpRace, "Results"),
		    ExpRes  = Table.ExpandRecordColumn(ExpList, "Results",
		        {"number", "position", "positionText", "points", "grid", "laps",
		         "status", "Driver", "Constructor", "Time", "FastestLap"}),
		    ExpDrv  = Table.ExpandRecordColumn(ExpRes, "Driver",
		        {"driverId", "code", "givenName", "familyName", "nationality"}),
		    ExpCon  = Table.ExpandRecordColumn(ExpDrv, "Constructor",
		        {"constructorId", "name"}, {"constructorId", "constructorName"}),
		    ExpTime = Table.ExpandRecordColumn(ExpCon, "Time",
		        {"millis"}, {"raceMillis"}),
		    ExpFL   = Table.ExpandRecordColumn(ExpTime, "FastestLap",
		        {"rank"}, {"fastestLapRank"}),
		    Typed = Table.TransformColumnTypes(ExpFL, {
		        {"season", Int64.Type}, {"round", Int64.Type},
		        {"number", Int64.Type}, {"position", Int64.Type},
		        {"points", type number}, {"grid", Int64.Type},
		        {"laps", Int64.Type}, {"raceMillis", Int64.Type},
		        {"fastestLapRank", Int64.Type}
		    }, "en-US"),
		    AddRaceKey = Table.AddColumn(Typed, "RaceKey",
		        each [season] * 100 + [round], Int64.Type)
		in
		    AddRaceKey
	lineageTag: a2ab3385-1a82-4e68-903f-9134b15cf08e
	queryGroup: Staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression hist_Results =
		let
		    E   = Table.SelectColumns(HistCsv("formula_one_sessionentry"),
		            {"session_id","round_entry_id","position","grid","points",
		             "laps_completed","status","detail","fastest_lap_rank","is_classified"}),
		    Ses = Table.RenameColumns(
		            Table.SelectRows(
		                Table.SelectColumns(HistCsv("formula_one_session"), {"id","round_id","type"}),
		                each [type] = "R"),
		            {{"id","ses_id"}}),
		    Rnd = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_round"),
		                {"id","season_id","number","name","date","circuit_id"}),
		            {{"id","rnd_id"},{"number","round"},{"name","raceName"}}),
		    Sea = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_season"), {"id","year"}),
		            {{"id","sea_id"}}),
		    RE  = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_roundentry"),
		                {"id","team_driver_id","car_number"}),
		            {{"id","re_id"}}),
		    TD  = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_teamdriver"),
		                {"id","driver_id","team_id"}),
		            {{"id","td_id"}}),
		    Drv = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_driver"),
		                {"id","reference","abbreviation","forename","surname","nationality"}),
		            {{"id","drv_id"},{"reference","driverId"},{"abbreviation","code"},
		             {"forename","givenName"},{"surname","familyName"}}),
		    Tm  = Table.RenameColumns(
		            Table.SelectColumns(HistCsv("formula_one_team"), {"id","reference","name"}),
		            {{"id","tm_id"},{"reference","constructorId"},{"name","constructorName"}}),
		
		    J1 = Table.Join(E,  "session_id", Ses, "ses_id"),
		    J2 = Table.Join(J1, "round_id",   Rnd, "rnd_id"),
		    J3 = Table.Join(J2, "season_id",  Sea, "sea_id"),
		    Hist = Table.SelectRows(J3, each Number.From([year]) < CurrentSeason),
		    J4 = Table.Join(Hist, "round_entry_id", RE, "re_id"),
		    J5 = Table.Join(J4, "team_driver_id",   TD, "td_id"),
		    J6 = Table.Join(J5, "driver_id",        Drv, "drv_id"),
		    J7 = Table.Join(J6, "team_id",          Tm, "tm_id"),
		
		    Renamed = Table.RenameColumns(J7, {{"year","season"},{"car_number","number"},
		                {"laps_completed","laps"},{"fastest_lap_rank","fastestLapRank"}}),
		    Typed = Table.TransformColumnTypes(Renamed, {
		                {"season", Int64.Type}, {"round", Int64.Type}, {"number", Int64.Type},
		                {"position", Int64.Type}, {"points", type number}, {"grid", Int64.Type},
		                {"laps", Int64.Type}, {"fastestLapRank", Int64.Type}}, "en-US"),
		    AddRaceKey = Table.AddColumn(Typed, "RaceKey",
		                each [season] * 100 + [round], Int64.Type),
		    Final = Table.SelectColumns(AddRaceKey,
		                {"season","round","RaceKey","number","position","points","grid","laps",
		                 "status","detail","is_classified","driverId","code","givenName",
		                 "familyName","nationality","constructorId","constructorName","fastestLapRank"})
		in
		    Final
	lineageTag: 20190246-802d-4048-bd41-bf9c4c905dc5
	queryGroup: Staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression api_Races =
		let
		    Source = Json.Document(
		        Web.Contents(
		            BaseUrl,
		            [
		                RelativePath = Number.ToText(CurrentSeason) & "/races/",
		                Query = [limit = "100"]
		            ]
		        )
		    ),
		    Races = Source[MRData][RaceTable][Races],
		    ToTable = Table.FromList(Races, Splitter.SplitByNothing(), {"Race"}),
		    ExpRace = Table.ExpandRecordColumn(ToTable, "Race",
		        {"season", "round", "raceName", "date", "time", "Circuit"}),
		    ExpCircuit = Table.ExpandRecordColumn(ExpRace, "Circuit",
		        {"circuitId", "circuitName", "Location"}),
		    ExpLoc = Table.ExpandRecordColumn(ExpCircuit, "Location",
		        {"locality", "country", "lat", "long"}),
		    Typed = Table.TransformColumnTypes(ExpLoc, {
		        {"season", Int64.Type}, {"round", Int64.Type},
		        {"date", type date}, {"lat", type number}, {"long", type number}
		    }, "en-US"),
		    AddRaceKey = Table.AddColumn(Typed, "RaceKey",
		        each [season] * 100 + [round], Int64.Type)
		in
		    AddRaceKey
	lineageTag: 44da54c5-87cc-45db-82e9-1b33b1845671
	queryGroup: Staging

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

